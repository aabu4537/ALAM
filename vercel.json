{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/books", "destination": "/api/index" },
    { "source": "/books/:path*", "destination": "/api/index" },
    { "source": "/demo/:path*", "destination": "/api/index" },
    { "source": "/internal/:path*", "destination": "/api/index" },
    { "source": "/preferences/:path*", "destination": "/api/index" },
    { "source": "/recommendations", "destination": "/api/index" },
    { "source": "/imports/:path*", "destination": "/api/index" }
  ]
}
