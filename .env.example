# Copy to .env and fill in. Never commit .env — see CLAUDE.md rule 9.

# --- Application ---
ALAM_ENV=local
ALAM_DEBUG=true
ALAM_LOG_LEVEL=INFO
# json in deployed environments, console for local readability
ALAM_LOG_FORMAT=console

# --- Database ---
# Local docker-compose value. In deployment this is the Supabase pooler URL
# (ADR-0005). pgvector must be enabled on the target database.
ALAM_DATABASE_URL=postgresql+psycopg://alam:alam@localhost:5432/alam

# Used only by the test suite, which drops and recreates the public schema on
# every run. Point it at a throwaway database, never at the one above.
# Unset means the database tests skip; CI sets it and also sets
# ALAM_REQUIRE_DB_TESTS=1 so a skip there is a failure.
ALAM_TEST_DATABASE_URL=postgresql+psycopg://alam:alam@localhost:5432/alam_test

# --- Job queue (M0) ---
# Only used by the always-on loop (`python -m alam.jobs.loop`). In production
# the schedule lives in Supabase Cron instead — see ADR-0007.
ALAM_WORKER_POLL_INTERVAL_SECONDS=1.0
ALAM_JOB_MAX_ATTEMPTS=5

# One drain claims at most this many jobs and runs for at most this long.
# The budget must stay well under the platform's function ceiling — 300s on
# Vercel Hobby with Fluid Compute — so an invocation returns rather than being
# killed mid-job.
ALAM_DRAIN_MAX_JOBS=10
ALAM_DRAIN_BUDGET_SECONDS=25.0

# How long a claim is held before another worker may reclaim it. MUST exceed
# ALAM_DRAIN_BUDGET_SECONDS or a job can be stolen from a worker still running
# it, and the same work happens twice with nothing erroring. Startup refuses
# to boot if this is violated.
ALAM_JOB_LEASE_SECONDS=120.0

# Bearer token for POST /internal/jobs/drain. The endpoint is public; unset
# means it refuses every caller rather than accepting them.
ALAM_DRAIN_SECRET=

# --- Demo persona (M1) ---
# Bearer token for POST /internal/demo/seed. Separate from ALAM_DRAIN_SECRET —
# different operation, different blast radius. GET /demo/books itself needs
# no secret; it is read-only and can never reach the owner's real data.
ALAM_DEMO_SEED_SECRET=

# --- Providers ---
# M0 ships fake providers only. No keys, no network calls in tests.
# See CLAUDE.md rule 8 and docs/milestones.md (M0).
ALAM_LLM_PROVIDER=fake
ALAM_EMBEDDING_PROVIDER=fake
ALAM_STT_PROVIDER=fake

# --- Embeddings (M3) ---
# Memories processed per POST /internal/embeddings/backfill batch job. Tunes
# how many batches a full catch-up takes; the job's own cursor design (not
# this number) is what makes it survive being killed mid-run. See ADR-0008.
ALAM_EMBEDDING_BACKFILL_BATCH_SIZE=50
