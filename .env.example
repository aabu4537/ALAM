# Copy to .env and fill in. Never commit .env — see CLAUDE.md rule 9.

# --- Application ---
ALAM_ENV=local
ALAM_DEBUG=true
ALAM_LOG_LEVEL=INFO
# json in deployed environments, console for local readability
ALAM_LOG_FORMAT=console

# --- Database ---
# Local docker-compose value. In deployment this is the Supabase pooler URL
# (ADR-0005). pgvector must be enabled on the target database.
ALAM_DATABASE_URL=postgresql+psycopg://alam:alam@localhost:5432/alam

# --- Job queue (M0) ---
ALAM_WORKER_POLL_INTERVAL_SECONDS=1.0
ALAM_WORKER_BATCH_SIZE=1
ALAM_JOB_MAX_ATTEMPTS=5

# --- Providers ---
# M0 ships fake providers only. No keys, no network calls in tests.
# See CLAUDE.md rule 8 and docs/milestones.md (M0).
ALAM_LLM_PROVIDER=fake
ALAM_EMBEDDING_PROVIDER=fake
ALAM_STT_PROVIDER=fake
